# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The only email allowed to sign in
ALLOWED_EMAIL=coop1090@outlook.com

# Where magic links send you back to (http://localhost:3000 locally, your Vercel URL in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auto-discovery (weekly job) ---
# Supabase → Settings → API Keys → service_role / secret key. Keep this Secret in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it so only the scheduler can trigger the weekly run.
CRON_SECRET=
# Optional disease focus for the weekly run, e.g. "oncology OR obesity"
DISCOVERY_CONDITIONS=
